# GEMINI_API_KEY: Required for Gemini AI Situation Report Copilot
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Google Maps JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Optional Copernicus Data Space Ecosystem API endpoint for live Sentinel-1/Sentinel-2 queries
SENTINEL_API_URL="https://sh.dataspace.copernicus.eu/api/v1"

# Overpass API for pre-event OpenStreetMap query
OSM_API_URL="https://overpass-api.de/api/interpreter"

# Copernicus DEM WCS/STAC API endpoint
COPERNICUS_API_URL="https://browser.dataspace.copernicus.eu"
